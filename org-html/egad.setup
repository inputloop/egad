# -*- mode: org; -*-
# egad org-html theme, hosted.  In your Org file:
#     #+SETUPFILE: https://egad.bru.st/org/egad.setup
# then export with C-c C-e h h (org-html-export-to-html).
# Offline, or from your own node, use egad-local.setup instead.
#+OPTIONS: html-style:nil html-scripts:nil toc:2 num:nil ^:nil
#+HTML_DOCTYPE: html5
#+HTML_HEAD: <meta name="viewport" content="width=device-width, initial-scale=1">
#+HTML_HEAD: <meta name="color-scheme" content="light dark">
#+HTML_HEAD: <link rel="stylesheet" type="text/css" href="https://egad.bru.st/org/egad.css">
#+HTML_HEAD: <link rel="alternate" type="application/json" href="https://egad.bru.st/.well-known/egad">
